                  3 Métodos
class Aluno {
  constructor(public nome: string, public nota: number) {}

  aprovado(): boolean {
    return this.nota >= 6;
  }
}

const aluno1 = new Aluno("Ana", 7.5);
console.log(aluno1.aprovado());
                                 4 this / self
class Retangulo {
  constructor(public largura: number, public altura: number) {}

  calcularPerimetro(): number {
    return 2 * (this.largura + this.altura);
  }
}

const ret = new Retangulo(10, 5);
console.log(ret.calcularPerimetro());                
                               

               5 Modificadores de acesso
class ContaBancaria {
  private saldo: number;

  constructor(saldoInicial: number) {
    this.saldo = saldoInicial;
  }

  depositar(valor: number): void {
    this.saldo += valor;
  }

  consultarSaldo(): number {
    return this.saldo;
  }
}

const conta = new ContaBancaria(100);
conta.depositar(50);
console.log(conta.consultarSaldo()); 
