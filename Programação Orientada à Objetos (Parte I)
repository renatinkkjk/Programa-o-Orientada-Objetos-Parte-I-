1 CLASSE E OBJETO        
class Pessoa {
  nome: string;
  idade: number;

  constructor(nome: string, idade: number) {
    this.nome = nome;
    this.idade = idade;
  }
}

const pessoa1 = new Pessoa("João", 17);
console.log(pessoa1.nome, pessoa1.idade);




